  "crystalTeaching": {
    "structureTypeZh": "混合晶体",
    "modelZh": "石墨层状教学模型",
    "coordinationNumberZh": "层内每个 C 原子与 3 个 C 原子成键",
    "spatialFeatureZh": "层内平面正六边形，层与层平行并错位堆叠",
    "unitCellDescriptionZh": "本模型展示上下两层平行石墨片段。每层内 C 原子通过 C-C 共价键连成六边形网络，层间只用范德华力示意，不表示普通化学键。",
    "particleCountZh": {
      "lines": ["层内每个 C 连接 3 个 C", "每条 C-C 键被 2 个 C 共享", "C 原子数 : C-C 键数 = 2 : 3"],
      "ratio": "石墨层内常考比例：C : C-C = 2 : 3。"
    },
    "coordinationDescriptionZh": [
      "石墨层内碳原子采取 sp² 杂化，形成近似 120° 的平面三角环境。",
      "每个 C 原子与同层 3 个 C 原子形成 C-C 共价键。",
      "层与层之间距离较大，主要依靠较弱范德华力结合。",
      "层内离域 π 电子可在平面内移动，帮助解释石墨能导电。"
    ],
    "commonMistakesZh": [
      "层间虚线表示范德华力，不是 C-C 共价键。",
      "虚线带表示层与层之间的弱相互作用区域，不表示某两个 C 原子之间形成化学键。",
      "不要把石墨理解成像金刚石一样的三维共价网状晶体。",
      "π 电子云是离域电子示意，不表示层间形成普通化学键。"
    ],
    "viewModes": [
