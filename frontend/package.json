{
  "name": "chem3d-learn-frontend",
  "private": true,
  "version": "0.1.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/chem3D-learn/",
    "build:sites": "npm run build && node scripts/prepare-sites-build.mjs",
    "lint": "eslint .",
    "check": "npm run build && npm run test:visual",
    "test:logic": "playwright test --config=playwright.logic.config.ts",
    "test:production": "npm run build && playwright test --config=playwright.production.config.ts",
    "test:pages": "npm run build:pages && node --test tests/deployment/github-pages-build.test.mjs",
    "test:sites": "npm run build:sites && node --test tests/deployment/sites-spa-fallback.test.mjs",
    "preview": "vite preview",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-slot": "^1.1.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^2.5.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.0.5"
  }
}
